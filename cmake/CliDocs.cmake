# Checks or updates the generated CLI reference in README.md.
# Inputs: EXE (penumbra binary), README, MODE (check | update).

set(begin_marker "<!-- BEGIN CLI REFERENCE: generated by `penumbra --help-markdown`, do not edit by hand -->")
set(end_marker "<!-- END CLI REFERENCE -->")

execute_process(COMMAND "${EXE}" --help-markdown OUTPUT_VARIABLE generated RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "penumbra --help-markdown failed with exit code ${rc}")
endif()
string(REPLACE "\r" "" generated "${generated}")

file(READ "${README}" readme)
string(REPLACE "\r" "" readme "${readme}")
string(FIND "${readme}" "${begin_marker}" begin_pos)
string(FIND "${readme}" "${end_marker}" end_pos)
if(begin_pos EQUAL -1 OR end_pos EQUAL -1 OR end_pos LESS begin_pos)
  message(FATAL_ERROR "README.md is missing the CLI reference markers:\n${begin_marker}\n${end_marker}")
endif()

string(LENGTH "${begin_marker}" begin_len)
math(EXPR content_start "${begin_pos} + ${begin_len}")
math(EXPR content_len "${end_pos} - ${content_start}")
string(SUBSTRING "${readme}" ${content_start} ${content_len} current)
set(expected "\n${generated}")

if(MODE STREQUAL "check")
  if(NOT current STREQUAL expected)
    message(FATAL_ERROR "The CLI reference in README.md is out of date. Regenerate it with:\n"
                        "  cmake --build --preset <your-preset> --target update-cli-docs")
  endif()
  message(STATUS "README.md CLI reference matches --help-markdown")
else()
  string(SUBSTRING "${readme}" 0 ${content_start} head)
  string(SUBSTRING "${readme}" ${end_pos} -1 tail)
  file(WRITE "${README}" "${head}${expected}${tail}")
  message(STATUS "Updated the CLI reference in ${README}")
endif()
