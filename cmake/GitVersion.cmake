# Writes version_info.cpp with the app version and git hash. Runs at every build, but only
# rewrites the file when the content changes, so it does not trigger needless recompiles.
# Inputs: SOURCE_DIR, OUTPUT, VERSION, GIT (may be empty).

set(hash "unknown")
if(GIT)
  execute_process(COMMAND "${GIT}" -C "${SOURCE_DIR}" rev-parse --short=12 HEAD
                  OUTPUT_VARIABLE out RESULT_VARIABLE rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(rc EQUAL 0 AND NOT out STREQUAL "")
    set(hash "${out}")
    execute_process(COMMAND "${GIT}" -C "${SOURCE_DIR}" status --porcelain --untracked-files=no
                    OUTPUT_VARIABLE status RESULT_VARIABLE rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(rc EQUAL 0 AND NOT status STREQUAL "")
      string(APPEND hash "-dirty")
    endif()
  endif()
endif()

set(content "// Generated by cmake/GitVersion.cmake at build time. Do not edit.
#include \"core/version.h\"

namespace pen {
std::string_view appVersion() { return \"${VERSION}\"; }
std::string_view gitHash() { return \"${hash}\"; }
}  // namespace pen
")

if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" old)
  if(old STREQUAL content)
    return()
  endif()
endif()
file(WRITE "${OUTPUT}" "${content}")
