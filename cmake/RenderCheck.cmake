# Renders with penumbra and checks the result with penumbra-diff.
# Inputs: PENUMBRA, DIFF, WORKDIR, NAME, SCENE, ARGS ("|"-separated extra flags), MODE and per mode:
#   uniform      TOLERANCE                 every pixel within TOLERANCE (relative) of 1.0 (furnace test)
#   threads      THREADS ("|"-separated)   renders once per thread count; all outputs must be bit-identical
#   reference    REFERENCE, MAXRELMSE      relMSE against a golden image
#   runs         -                         the render must succeed

string(REPLACE "|" ";" extra "${ARGS}")
set(common --terminal "${SCENE}" --config "${WORKDIR}/empty-config.json" --log-file "${WORKDIR}/${NAME}.log"
           --progress plain --bit-depth 32 ${extra})
file(WRITE "${WORKDIR}/empty-config.json" "{}\n")

# Renders `out`; extra arguments go to penumbra. RENDER_ENV (e.g. "PENUMBRA_TEST_FAULTS=...") is set for the
# process when defined. The log text is left in `last_log` in the caller's scope.
function(render out)
  set(env_prefix "")
  if(DEFINED RENDER_ENV AND NOT RENDER_ENV STREQUAL "")
    set(env_prefix "${CMAKE_COMMAND}" -E env "${RENDER_ENV}")
  endif()
  execute_process(COMMAND ${env_prefix} "${PENUMBRA}" ${common} -o "${out}" ${ARGN} WORKING_DIRECTORY "${WORKDIR}"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "render failed (exit ${rc}):\n${o}${e}")
  endif()
  message(STATUS "rendered ${out}")
  set(last_log "${o}${e}" PARENT_SCOPE)
endfunction()

function(diff)
  execute_process(COMMAND "${DIFF}" ${ARGN} WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc OUTPUT_VARIABLE o
                  ERROR_VARIABLE e)
  message(STATUS "${o}${e}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "penumbra-diff ${ARGN} failed (exit ${rc})")
  endif()
endfunction()

if(MODE STREQUAL "uniform")
  render("${NAME}.exr")
  diff("${NAME}.exr" --uniform 1 --tolerance ${TOLERANCE})
elseif(MODE STREQUAL "threads")
  string(REPLACE "|" ";" thread_list "${THREADS}")
  set(first "")
  foreach(t IN LISTS thread_list)
    render("${NAME}_t${t}.exr" --threads ${t})
    if(first STREQUAL "")
      set(first "${NAME}_t${t}.exr")
    else()
      diff("${first}" "${NAME}_t${t}.exr" --exact)
    endif()
  endforeach()
elseif(MODE STREQUAL "reference")
  render("${NAME}.exr")
  diff("${NAME}.exr" "${REFERENCE}" --max-relmse ${MAXRELMSE})
elseif(MODE STREQUAL "runs")
  render("${NAME}.exr")
elseif(MODE STREQUAL "devices")
  # The same image, bit for bit, whatever the number of device slots (D-045). DEVICE_SETS: "+"-separated.
  string(REPLACE "+" ";" sets "${DEVICE_SETS}")
  set(first "")
  set(i 0)
  foreach(d IN LISTS sets)
    render("${NAME}_${i}.exr" --devices ${d})
    if(first STREQUAL "")
      set(first "${NAME}_${i}.exr")
    else()
      diff("${first}" "${NAME}_${i}.exr" --exact)
    endif()
    math(EXPR i "${i} + 1")
  endforeach()
elseif(MODE STREQUAL "faults")
  # One device fails or hangs mid-render (PENUMBRA_TEST_FAULTS); the image must not change.
  render("${NAME}_ref.exr" --devices ${REF_DEVICES})
  set(RENDER_ENV "PENUMBRA_TEST_FAULTS=${FAULTS}")
  render("${NAME}_fault.exr" --devices ${FAULT_DEVICES})
  if(NOT last_log MATCHES "${EXPECT_LOG}")
    message(FATAL_ERROR "the log does not show '${EXPECT_LOG}':\n${last_log}")
  endif()
  string(REGEX MATCH "[0-9]+ lease\\(s\\) were handed out again" handed "${last_log}")
  message(STATUS "${handed}")
  diff("${NAME}_fault.exr" "${NAME}_ref.exr" --exact)
elseif(MODE STREQUAL "timelimit")
  render("${NAME}.exr")
  if(NOT last_log MATCHES "time limit reached")
    message(FATAL_ERROR "the render did not stop at the time limit:\n${last_log}")
  endif()
elseif(MODE STREQUAL "resume")
  # Reference, then a run killed (no clean shutdown) after its first checkpoint, then --resume: bit-identical.
  render("${NAME}_ref.exr")
  file(REMOVE "${WORKDIR}/${NAME}_cut.exr" "${WORKDIR}/${NAME}_cut.penfilm" "${WORKDIR}/${NAME}_cut.session.json")
  if(NOT DEFINED CUT_THREADS)
    set(CUT_THREADS 2)
  endif()
  execute_process(COMMAND "${PENUMBRA}" ${common} -o "${NAME}_cut.exr" --threads ${CUT_THREADS} --checkpoint 10s
                  WORKING_DIRECTORY "${WORKDIR}" TIMEOUT ${KILL_AFTER} RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
  if(rc EQUAL 0)
    message(FATAL_ERROR "the render finished before it was killed after ${KILL_AFTER}s; raise --spp for this test")
  endif()
  message(STATUS "killed after ${KILL_AFTER}s (${rc})")
  if(NOT EXISTS "${WORKDIR}/${NAME}_cut.session.json")
    message(FATAL_ERROR "no session file after the kill:\n${o}${e}")
  endif()
  execute_process(COMMAND "${PENUMBRA}" --config "${WORKDIR}/empty-config.json" --log-file "${WORKDIR}/${NAME}.log"
                          --terminal --resume "${NAME}_cut.session.json" --progress plain
                  WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "--resume failed (exit ${rc}):\n${o}${e}")
  endif()
  if(NOT "${o}${e}" MATCHES "resume: [1-9][0-9]* of [0-9]+ tiles already have samples")
    message(FATAL_ERROR "the resumed render did not reuse any tile from the film:\n${o}${e}")
  endif()
  string(REGEX MATCH "resume: [0-9]+ of [0-9]+ tiles" reused "${o}${e}")
  message(STATUS "${reused} reused")
  diff("${NAME}_cut.exr" "${NAME}_ref.exr" --exact)
  if(EXISTS "${WORKDIR}/${NAME}_cut.session.json")
    message(FATAL_ERROR "the session file should be deleted after the render completes")
  endif()
elseif(MODE STREQUAL "interrupt")
  # Ctrl+C (SIGINT): exit code 5, session kept as "interrupted", current image written; --resume finishes it
  # and matches an uninterrupted render bit for bit.
  render("${NAME}_ref.exr")
  file(REMOVE "${WORKDIR}/${NAME}_int.exr" "${WORKDIR}/${NAME}_int.penfilm" "${WORKDIR}/${NAME}_int.session.json")
  execute_process(COMMAND timeout --preserve-status -s INT ${KILL_AFTER} "${PENUMBRA}" ${common} -o "${NAME}_int.exr"
                          --threads 2
                  WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
  if(NOT rc EQUAL 5)
    message(FATAL_ERROR "expected exit code 5 after Ctrl+C, got ${rc}:\n${o}${e}")
  endif()
  if(NOT EXISTS "${WORKDIR}/${NAME}_int.exr")
    message(FATAL_ERROR "the interrupted render did not write its current image")
  endif()
  file(READ "${WORKDIR}/${NAME}_int.session.json" session)
  if(NOT session MATCHES "\"state\": \"interrupted\"")
    message(FATAL_ERROR "session state is not 'interrupted':\n${session}")
  endif()
  execute_process(COMMAND "${PENUMBRA}" --config "${WORKDIR}/empty-config.json" --log-file "${WORKDIR}/${NAME}.log"
                          --terminal --resume "${NAME}_int.session.json" --progress plain
                  WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "--resume failed (exit ${rc}):\n${o}${e}")
  endif()
  diff("${NAME}_int.exr" "${NAME}_ref.exr" --exact)
elseif(MODE STREQUAL "merge_regions")
  render("${NAME}_ref.exr")
  render("${NAME}_left.exr" --region 0,0,1024,1080)
  render("${NAME}_right.exr" --region 1024,0,1920,1080)
  execute_process(COMMAND "${PENUMBRA}" --config "${WORKDIR}/empty-config.json" --log-file "${WORKDIR}/${NAME}.log"
                          --bit-depth 32 merge "${NAME}_left.penfilm" "${NAME}_right.penfilm" -o "${NAME}_merged.exr"
                  WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "merge failed (exit ${rc}):\n${o}${e}")
  endif()
  diff("${NAME}_merged.exr" "${NAME}_ref.exr" --exact)
elseif(MODE STREQUAL "merge_samples")
  render("${NAME}_ref.exr")
  render("${NAME}_a.exr" --sample-range 0-3)
  render("${NAME}_b.exr" --sample-range 4-7)
  execute_process(COMMAND "${PENUMBRA}" --config "${WORKDIR}/empty-config.json" --log-file "${WORKDIR}/${NAME}.log"
                          --bit-depth 32 merge "${NAME}_a.penfilm" "${NAME}_b.penfilm" -o "${NAME}_merged.exr"
                  WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "merge failed (exit ${rc}):\n${o}${e}")
  endif()
  # Float rounding of the weighted mean differs slightly from one 8-sample average (docs/GUIDE.md: < 1e-6).
  diff("${NAME}_merged.exr" "${NAME}_ref.exr" --max-relmse 1e-6)
elseif(MODE STREQUAL "region_crop")
  render("${NAME}_ref.exr")
  render("${NAME}_crop.exr" --region 300,200,700,500)
  diff("${NAME}_ref.exr" "${NAME}_crop.exr" --crop 300,200,700,500 --exact)
elseif(MODE STREQUAL "presets")
  foreach(p 120p 240p 360p 480p 720p 1080p 2k 4k 6k 8k 10k 15k 20k 40k 60k 80k 160k)
    render("${NAME}_${p}.exr" --res ${p})
  endforeach()
elseif(MODE STREQUAL "large")
  # A whole 20K frame, then one tile rendered alone with --region must match the same pixels of the big file.
  render("${NAME}.exr")
  render("${NAME}_tile.exr" --region 10240,5632,10496,5888)
  diff("${NAME}.exr" "${NAME}_tile.exr" --crop 10240,5632,10496,5888 --exact)
elseif(MODE STREQUAL "network")
  # A hosting controller plus WORKERS worker processes on loopback must give the solo render, bit for bit.
  # Inputs: NETTEST, PORT, WORKERS, REF_ARGS, CONTROLLER_ARGS, WORKER_ARGS ("|"-separated). Optional:
  #   WORKER_DELAY_MS     start worker i at i x this (default 300)
  #   WORKER_EXPECT       exit code of the workers (default 0)
  #   EXPECT_LOG          regex the controller log must match
  #   WRONG_CODE_WORKERS  that many more workers with a wrong code, expecting exit 6
  #   BAD_VERSION_WORKER  1: one more worker posing as another git commit, expecting exit 6
  #   SHARED_CACHE        1: all workers use one scene cache folder (else one each)
  #   CRASH_FIRST_AFTER_CHUNKS  worker 1 exits abruptly (137) after receiving this many scene chunks; worker 2
  #                       starts once it has gone
  #   FULL_DISK_WORKER    1: one more worker whose cache disk looks full (scene_rejected), expecting exit 0
  #   RUNS                render this many times with the same caches (default 1)
  string(REPLACE "|" ";" ref_args "${REF_ARGS}")
  render("${NAME}_ref.exr" ${ref_args})
  if(NOT DEFINED WORKER_DELAY_MS)
    set(WORKER_DELAY_MS 300)
  endif()
  if(NOT DEFINED WORKER_EXPECT)
    set(WORKER_EXPECT 0)
  endif()
  if(NOT DEFINED RUNS)
    set(RUNS 1)
  endif()
  file(GLOB old_caches "${WORKDIR}/${NAME}_cache*")
  if(old_caches)
    file(REMOVE_RECURSE ${old_caches})
  endif()
  file(REMOVE "${WORKDIR}/${NAME}.log")
  set(code K7QD-M2XR-9FHT-4WNB)
  string(REPLACE ";" "|" ctl "${PENUMBRA};${common};-o;${NAME}_net.exr;--host;--port;${PORT};--code;${code}")
  set(procs --proc "${NAME}_ctl" 0 0 0 "${ctl}|${CONTROLLER_ARGS}")
  set(join "--worker|--join|127.0.0.1:${PORT}|--config|${WORKDIR}/empty-config.json")
  foreach(i RANGE 1 ${WORKERS})
    if(SHARED_CACHE)
      set(cache "${WORKDIR}/${NAME}_cache")
    else()
      set(cache "${WORKDIR}/${NAME}_cache_w${i}")
    endif()
    set(w "${PENUMBRA}|${join}|--code|${code}|--cache-dir|${cache}|--log-file|${WORKDIR}/${NAME}_w${i}.log")
    string(APPEND w "|--worker-name|w${i}|${WORKER_ARGS}")
    math(EXPR delay "${WORKER_DELAY_MS} * ${i}")
    if(i EQUAL 1 AND DEFINED CRASH_FIRST_AFTER_CHUNKS)
      list(APPEND procs --proc "${NAME}_w${i}" ${delay} 137 0
           "${CMAKE_COMMAND}|-E|env|PENUMBRA_TEST_EXIT_AFTER_CHUNKS=${CRASH_FIRST_AFTER_CHUNKS}|${w}")
    elseif(i EQUAL 2 AND DEFINED CRASH_FIRST_AFTER_CHUNKS)
      list(APPEND procs --proc "${NAME}_w${i}" "after:${NAME}_w1" ${WORKER_EXPECT} 0 "${w}")
    else()
      list(APPEND procs --proc "${NAME}_w${i}" ${delay} ${WORKER_EXPECT} 0 "${w}")
    endif()
  endforeach()
  math(EXPR late "${WORKER_DELAY_MS} * (${WORKERS} + 1) + 1500")  # after the good workers have joined
  if(DEFINED WRONG_CODE_WORKERS AND WRONG_CODE_WORKERS GREATER 0)
    foreach(i RANGE 1 ${WRONG_CODE_WORKERS})
      set(w "${PENUMBRA}|${join}|--code|AAAA-AAAA-AAAA-AAAA|--log-file|${WORKDIR}/${NAME}_bad${i}.log|--worker-name|bad${i}")
      math(EXPR delay "${late} + 200 * ${i}")
      list(APPEND procs --proc "${NAME}_bad${i}" ${delay} 6 0 "${w}")
    endforeach()
  endif()
  if(BAD_VERSION_WORKER)
    set(w "${CMAKE_COMMAND}|-E|env|PENUMBRA_TEST_GIT_HASH=0000000badc0de|${PENUMBRA}|${join}|--code|${code}")
    string(APPEND w "|--log-file|${WORKDIR}/${NAME}_oldver.log|--worker-name|oldver")
    list(APPEND procs --proc "${NAME}_oldver" ${late} 6 0 "${w}")
  endif()
  if(FULL_DISK_WORKER)
    set(w "${CMAKE_COMMAND}|-E|env|PENUMBRA_TEST_FREE_DISK=1000|${PENUMBRA}|${join}|--code|${code}")
    string(APPEND w "|--cache-dir|${WORKDIR}/${NAME}_cache_full|--log-file|${WORKDIR}/${NAME}_full.log|--worker-name|full")
    list(APPEND procs --proc "${NAME}_full" 0 0 0 "${w}")
  endif()
  foreach(run RANGE 1 ${RUNS})
    file(REMOVE "${WORKDIR}/${NAME}_net.exr")
    execute_process(COMMAND "${NETTEST}" --workdir "${WORKDIR}" --timeout 900 ${procs} WORKING_DIRECTORY "${WORKDIR}"
                    RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
    message(STATUS "run ${run}:\n${o}${e}")
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "the network render failed (run ${run})")
    endif()
    diff("${NAME}_net.exr" "${NAME}_ref.exr" --exact)
  endforeach()
  file(READ "${WORKDIR}/${NAME}.log" ctl_log)
  if(DEFINED EXPECT_LOG AND NOT ctl_log MATCHES "${EXPECT_LOG}")
    message(FATAL_ERROR "the controller log does not show '${EXPECT_LOG}'")
  endif()
  string(REGEX MATCHALL "\] [^\n]*: [0-9]+ items, [^\n]*" tallies "${ctl_log}")
  foreach(t IN LISTS tallies)
    message(STATUS "${t}")
  endforeach()
else()
  message(FATAL_ERROR "unknown MODE '${MODE}'")
endif()
