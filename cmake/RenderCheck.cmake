# Renders with penumbra and checks the result with penumbra-diff.
# Inputs: PENUMBRA, DIFF, WORKDIR, NAME, SCENE, ARGS ("|"-separated extra flags), MODE and per mode:
#   uniform      TOLERANCE                 every pixel within TOLERANCE (relative) of 1.0 (furnace test)
#   threads      THREADS ("|"-separated)   renders once per thread count; all outputs must be bit-identical
#   reference    REFERENCE, MAXRELMSE      relMSE against a golden image
#   runs         -                         the render must succeed
#   pair         ARGS_A, ARGS_B, MAXRELMSE two renders that differ only in ARGS_A / ARGS_B agree within MAXRELMSE
#                (EXPECT_LOG: a regex the second render's log must match)
# Renders use the CPU unless ARGS names a backend, so a test means the same on a machine with a GPU.

string(REPLACE "|" ";" extra "${ARGS}")
if(NOT "${ARGS}${ARGS_A}${ARGS_B}" MATCHES "--backend")
  list(APPEND extra --backend cpu)
endif()
# render() uses 4 threads, as the test declares to ctest (PROCESSORS 4), so tests running side by side share the
# cores fairly (D-106); the image does not depend on the thread count (render.threads_*).
set(pin_threads --threads 4)
if("${ARGS}" MATCHES "--threads")
  set(pin_threads "")
endif()
# Each test has its own empty config file: tests run side by side (ctest -j), and Windows may refuse to open a file
# another test is rewriting.
set(cfg "${WORKDIR}/${NAME}_config.json")
file(WRITE "${cfg}" "{}\n")
set(common --terminal "${SCENE}" --config "${cfg}" --log-file "${WORKDIR}/${NAME}.log" --progress plain
           --bit-depth 32 ${extra})

# MIN_GPUS=N: a multi-GPU test prints "SKIPPED:" (the test's SKIP_REGULAR_EXPRESSION) on a machine with fewer
# GPUs that can render, as `penumbra --list-devices` numbers them.
if(DEFINED MIN_GPUS)
  execute_process(COMMAND "${PENUMBRA}" --list-devices OUTPUT_VARIABLE o ERROR_VARIABLE e)
  string(REGEX MATCHALL "\n  [0-9]+ +[^\n]*" gpus "\n${o}")
  list(LENGTH gpus gpu_count)
  if(gpu_count LESS MIN_GPUS)
    message(STATUS "SKIPPED: this machine has ${gpu_count} GPU(s) that can render; the test needs ${MIN_GPUS}")
    return()
  endif()
endif()

# SMALL_CHUNKS=1: work items of 2^22 pixel-samples instead of the default (tests that need many items per tile,
# DECISIONS D-083). Network tests always use it. Set in this script's environment, which every process it starts
# inherits: wrapping penumbra in `cmake -E env` would make a kill hit the wrapper and leave penumbra running.
if(SMALL_CHUNKS OR MODE STREQUAL "network")
  set(ENV{PENUMBRA_TEST_CHUNK_BUDGET} 4194304)
endif()
# TEXTURE_HALVINGS=k: CPU renders halve every texture k times, as a GPU at memory tier 2 does (M8, D-108); GPU
# devices ignore it.
if(DEFINED TEXTURE_HALVINGS)
  set(ENV{PENUMBRA_TEST_TEXTURE_HALVINGS} ${TEXTURE_HALVINGS})
endif()
# NO_TAIL=1: no tail duplication (D-091), so a hung device is caught by the late-lease check instead.
if(NO_TAIL)
  set(ENV{PENUMBRA_TEST_NO_TAIL_DUPLICATION} 1)
endif()

# Renders `out`; extra arguments go to penumbra. RENDER_ENV (e.g. "PENUMBRA_TEST_FAULTS=...") is set for the
# process when defined. The log text is left in `last_log` in the caller's scope.
function(render out)
  set(env_prefix "")
  if(DEFINED RENDER_ENV AND NOT RENDER_ENV STREQUAL "")
    set(env_prefix "${CMAKE_COMMAND}" -E env "${RENDER_ENV}")
  endif()
  set(threads ${pin_threads})
  if("${ARGN}" MATCHES "--threads")
    set(threads "")
  endif()
  execute_process(COMMAND ${env_prefix} "${PENUMBRA}" ${common} -o "${out}" ${threads} ${ARGN}
                  WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "render failed (exit ${rc}):\n${o}${e}")
  endif()
  message(STATUS "rendered ${out}")
  set(last_log "${o}${e}" PARENT_SCOPE)
endfunction()

# Renders the solo reference `out` (arguments as for render()), or copies it from the reference cache: many tests
# compare against the same image (D-106). The key is the penumbra binary, the scene, every argument that can
# change pixels and the work-item size; the log and config paths are left out. Written under a temporary name, then renamed, so tests
# running side by side never read a half-written file.
function(reference out)
  file(SHA256 "${PENUMBRA}" exe_hash)
  file(SHA256 "${SCENE}" scene_hash)
  # The work-item size is part of the key: chunks are merged into the film in another order, which changes the
  # last bits (relMSE ~1e-15) though not the image.
  string(SHA256 key "${exe_hash}|${scene_hash}|${extra}|${ARGN}|chunks=$ENV{PENUMBRA_TEST_CHUNK_BUDGET}|halvings=$ENV{PENUMBRA_TEST_TEXTURE_HALVINGS}")
  string(SUBSTRING "${key}" 0 24 key)
  set(cached "${WORKDIR}/refcache/${key}.exr")
  if(EXISTS "${cached}")
    file(COPY_FILE "${cached}" "${WORKDIR}/${out}")
    message(STATUS "reference ${out} from the cache (${key})")
    return()
  endif()
  render("${out}" ${ARGN})
  file(MAKE_DIRECTORY "${WORKDIR}/refcache")
  string(RANDOM LENGTH 8 tmp)
  file(COPY_FILE "${WORKDIR}/${out}" "${cached}.${tmp}")
  file(RENAME "${cached}.${tmp}" "${cached}")
endfunction()

function(diff)
  execute_process(COMMAND "${DIFF}" ${ARGN} WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc OUTPUT_VARIABLE o
                  ERROR_VARIABLE e)
  message(STATUS "${o}${e}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "penumbra-diff ${ARGN} failed (exit ${rc})")
  endif()
endfunction()

if(MODE STREQUAL "uniform")
  render("${NAME}.exr")
  diff("${NAME}.exr" --uniform 1 --tolerance ${TOLERANCE})
elseif(MODE STREQUAL "threads")
  string(REPLACE "|" ";" thread_list "${THREADS}")
  set(first "")
  foreach(t IN LISTS thread_list)
    render("${NAME}_t${t}.exr" --threads ${t})
    if(first STREQUAL "")
      set(first "${NAME}_t${t}.exr")
    else()
      diff("${first}" "${NAME}_t${t}.exr" --exact)
    endif()
  endforeach()
elseif(MODE STREQUAL "reference")
  render("${NAME}.exr")
  diff("${NAME}.exr" "${REFERENCE}" --max-relmse ${MAXRELMSE})
elseif(MODE STREQUAL "runs")
  render("${NAME}.exr")
elseif(MODE STREQUAL "pair")
  string(REPLACE "|" ";" a "${ARGS_A}")
  string(REPLACE "|" ";" b "${ARGS_B}")
  render("${NAME}_a.exr" ${a})
  render("${NAME}_b.exr" ${b})
  if(DEFINED EXPECT_LOG AND NOT last_log MATCHES "${EXPECT_LOG}")  # checked against the second render
    message(FATAL_ERROR "the log of the second render does not show '${EXPECT_LOG}':\n${last_log}")
  endif()
  diff("${NAME}_a.exr" "${NAME}_b.exr" --max-relmse ${MAXRELMSE})
elseif(MODE STREQUAL "devices")
  # The same image, bit for bit, whatever the number of device slots (D-045). DEVICE_SETS: "+"-separated.
  string(REPLACE "+" ";" sets "${DEVICE_SETS}")
  set(first "")
  set(i 0)
  foreach(d IN LISTS sets)
    render("${NAME}_${i}.exr" --devices ${d})
    if(first STREQUAL "")
      set(first "${NAME}_${i}.exr")
    else()
      diff("${first}" "${NAME}_${i}.exr" --exact)
    endif()
    math(EXPR i "${i} + 1")
  endforeach()
elseif(MODE STREQUAL "faults")
  # One device fails or hangs mid-render (PENUMBRA_TEST_FAULTS); the image must not change.
  reference("${NAME}_ref.exr" --devices ${REF_DEVICES})
  set(RENDER_ENV "PENUMBRA_TEST_FAULTS=${FAULTS}")
  render("${NAME}_fault.exr" --devices ${FAULT_DEVICES})
  if(NOT last_log MATCHES "${EXPECT_LOG}")
    message(FATAL_ERROR "the log does not show '${EXPECT_LOG}':\n${last_log}")
  endif()
  string(REGEX MATCH "[0-9]+ lease\\(s\\) were handed out again" handed "${last_log}")
  message(STATUS "${handed}")
  diff("${NAME}_fault.exr" "${NAME}_ref.exr" --exact)
elseif(MODE STREQUAL "timelimit")
  render("${NAME}.exr")
  if(NOT last_log MATCHES "time limit reached")
    message(FATAL_ERROR "the render did not stop at the time limit:\n${last_log}")
  endif()
elseif(MODE STREQUAL "resume")
  # Reference, then a run killed (no clean shutdown) right after a checkpoint once KILL_AFTER_ITEMS chunks are
  # merged (test hook PENUMBRA_TEST_KILL_AFTER_ITEMS, D-095), then --resume: bit-identical.
  reference("${NAME}_ref.exr")
  file(REMOVE "${WORKDIR}/${NAME}_cut.exr" "${WORKDIR}/${NAME}_cut.penfilm" "${WORKDIR}/${NAME}_cut.session.json")
  if(NOT DEFINED CUT_THREADS)
    set(CUT_THREADS 2)
  endif()
  set(ENV{PENUMBRA_TEST_KILL_AFTER_ITEMS} ${KILL_AFTER_ITEMS})
  execute_process(COMMAND "${PENUMBRA}" ${common} -o "${NAME}_cut.exr" --threads ${CUT_THREADS} --checkpoint 10m
                  WORKING_DIRECTORY "${WORKDIR}" TIMEOUT 1800 RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
  unset(ENV{PENUMBRA_TEST_KILL_AFTER_ITEMS})
  if(NOT rc EQUAL 137)
    message(FATAL_ERROR "the render was not cut after ${KILL_AFTER_ITEMS} chunks (exit ${rc}); raise --spp:\n${o}${e}")
  endif()
  message(STATUS "cut after ${KILL_AFTER_ITEMS} merged chunks (${rc})")
  if(NOT EXISTS "${WORKDIR}/${NAME}_cut.session.json")
    message(FATAL_ERROR "no session file after the kill:\n${o}${e}")
  endif()
  execute_process(COMMAND "${PENUMBRA}" --config "${cfg}" --log-file "${WORKDIR}/${NAME}.log"
                          --terminal --resume "${NAME}_cut.session.json" --progress plain
                  WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "--resume failed (exit ${rc}):\n${o}${e}")
  endif()
  if(NOT "${o}${e}" MATCHES "resume: [1-9][0-9]* of [0-9]+ tiles already have samples")
    message(FATAL_ERROR "the resumed render did not reuse any tile from the film:\n${o}${e}")
  endif()
  string(REGEX MATCH "resume: [0-9]+ of [0-9]+ tiles" reused "${o}${e}")
  message(STATUS "${reused} reused")
  diff("${NAME}_cut.exr" "${NAME}_ref.exr" --exact)
  if(EXISTS "${WORKDIR}/${NAME}_cut.session.json")
    message(FATAL_ERROR "the session file should be deleted after the render completes")
  endif()
elseif(MODE STREQUAL "interrupt")
  # Ctrl+C (SIGINT): exit code 5, session kept as "interrupted", current image written; --resume finishes it
  # and matches an uninterrupted render bit for bit.
  reference("${NAME}_ref.exr")
  file(REMOVE "${WORKDIR}/${NAME}_int.exr" "${WORKDIR}/${NAME}_int.penfilm" "${WORKDIR}/${NAME}_int.session.json")
  execute_process(COMMAND timeout --preserve-status -s INT ${KILL_AFTER} "${PENUMBRA}" ${common} -o "${NAME}_int.exr"
                          --threads 2
                  WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
  if(NOT rc EQUAL 5)
    message(FATAL_ERROR "expected exit code 5 after Ctrl+C, got ${rc}:\n${o}${e}")
  endif()
  if(NOT EXISTS "${WORKDIR}/${NAME}_int.exr")
    message(FATAL_ERROR "the interrupted render did not write its current image")
  endif()
  file(READ "${WORKDIR}/${NAME}_int.session.json" session)
  if(NOT session MATCHES "\"state\": \"interrupted\"")
    message(FATAL_ERROR "session state is not 'interrupted':\n${session}")
  endif()
  execute_process(COMMAND "${PENUMBRA}" --config "${cfg}" --log-file "${WORKDIR}/${NAME}.log"
                          --terminal --resume "${NAME}_int.session.json" --progress plain
                  WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "--resume failed (exit ${rc}):\n${o}${e}")
  endif()
  diff("${NAME}_int.exr" "${NAME}_ref.exr" --exact)
elseif(MODE STREQUAL "merge_regions")
  reference("${NAME}_ref.exr")
  render("${NAME}_left.exr" --region 0,0,1024,1080)
  render("${NAME}_right.exr" --region 1024,0,1920,1080)
  execute_process(COMMAND "${PENUMBRA}" --config "${cfg}" --log-file "${WORKDIR}/${NAME}.log"
                          --bit-depth 32 merge "${NAME}_left.penfilm" "${NAME}_right.penfilm" -o "${NAME}_merged.exr"
                  WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "merge failed (exit ${rc}):\n${o}${e}")
  endif()
  diff("${NAME}_merged.exr" "${NAME}_ref.exr" --exact)
elseif(MODE STREQUAL "merge_samples")
  reference("${NAME}_ref.exr")
  render("${NAME}_a.exr" --sample-range 0-3)
  render("${NAME}_b.exr" --sample-range 4-7)
  execute_process(COMMAND "${PENUMBRA}" --config "${cfg}" --log-file "${WORKDIR}/${NAME}.log"
                          --bit-depth 32 merge "${NAME}_a.penfilm" "${NAME}_b.penfilm" -o "${NAME}_merged.exr"
                  WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "merge failed (exit ${rc}):\n${o}${e}")
  endif()
  # Float rounding of the weighted mean differs slightly from one 8-sample average (docs/GUIDE.md: < 1e-6).
  diff("${NAME}_merged.exr" "${NAME}_ref.exr" --max-relmse 1e-6)
elseif(MODE STREQUAL "region_crop")
  reference("${NAME}_ref.exr")
  render("${NAME}_crop.exr" --region 300,200,700,500)
  diff("${NAME}_ref.exr" "${NAME}_crop.exr" --crop 300,200,700,500 --exact)
elseif(MODE STREQUAL "presets")
  foreach(p 120p 240p 360p 480p 720p 1080p 2k 4k 6k 8k 10k 15k 20k 40k 60k 80k 160k)
    render("${NAME}_${p}.exr" --res ${p})
  endforeach()
elseif(MODE STREQUAL "large")
  # A whole 20K frame, then one tile rendered alone with --region must match the same pixels of the big file.
  render("${NAME}.exr")
  render("${NAME}_tile.exr" --region 10240,5632,10496,5888)
  diff("${NAME}.exr" "${NAME}_tile.exr" --crop 10240,5632,10496,5888 --exact)
elseif(MODE STREQUAL "network")
  # A hosting controller plus WORKERS worker processes on loopback must give the solo render, bit for bit.
  # Inputs: NETTEST, PORT, WORKERS, REF_ARGS, CONTROLLER_ARGS, WORKER_ARGS ("|"-separated). Optional:
  #   WORKER_DELAY_MS     start worker i at i x this (default 300)
  #   WORKER_EXPECT       exit code of the workers (default 0)
  #   EXPECT_LOG          regex the controller log must match
  #   WRONG_CODE_WORKERS  that many more workers with a wrong code, expecting exit 6
  #   BAD_VERSION_WORKER  1: one more worker posing as another git commit, expecting exit 6
  #   SHARED_CACHE        1: all workers use one scene cache folder (else one each)
  #   CRASH_FIRST_AFTER_CHUNKS  worker 1 exits abruptly (137) after receiving this many scene chunks; worker 2
  #                       starts once it has gone
  #   FULL_DISK_WORKER    1: one more worker whose cache disk looks full (scene_rejected), expecting exit 0
  #   RUNS                render this many times with the same caches (default 1)
  #   FIRST_WORKER_ENV    environment for worker 1 (e.g. PENUMBRA_TEST_FAULTS=...), FIRST_WORKER_EXPECT its exit
  #                       code (default WORKER_EXPECT), FIRST_WORKER_ARGS extra flags ("|"-separated)
  #   NETEM_ARGS          workers connect through penumbra-netem-proxy (NETEM) on PORT+100 with these flags
  #   EXPECT_WORKER_LOG   regex worker 1's log must match
  #   WORKER_ENV          environment for every worker (e.g. PENUMBRA_TEST_NULL_DELAY_MS=500)
  #   CONTROLLER_KILL_MS  hard-kill the controller this long after it starts, then run it again with --resume;
  #                       use with --stay workers (WORKER_EXPECT=daemon)
  #   SECOND_RENDER       1: once the controller has finished, a second controller renders the same thing on the
  #                       same port (--stay workers serve both)
  #   TIME_SCALE          network and fault timers multiplier (default 0.2; 1 = real time)
  #   ITEM_SPAN           network workers get this many chunks per item (PENUMBRA_TEST_ITEM_SPAN, D-116)
  #   MAXRELMSE           compare with the solo render within this relMSE instead of bit for bit
  string(REPLACE "|" ";" ref_args "${REF_ARGS}")
  reference("${NAME}_ref.exr" ${ref_args})
  # Network and fault timers x TIME_SCALE (default 0.2: heartbeats, 30 s peer timeout -> 6 s, backoff; D-106),
  # inherited by every process below. An outside PENUMBRA_TEST_TIME_SCALE wins (for comparisons).
  if(NOT DEFINED TIME_SCALE)
    set(TIME_SCALE 0.2)
  endif()
  if(NOT DEFINED ENV{PENUMBRA_TEST_TIME_SCALE} AND NOT TIME_SCALE STREQUAL "1")
    set(ENV{PENUMBRA_TEST_TIME_SCALE} ${TIME_SCALE})
  endif()
  if(NOT DEFINED WORKER_DELAY_MS)
    set(WORKER_DELAY_MS 300)
  endif()
  if(DEFINED ITEM_SPAN)
    set(ENV{PENUMBRA_TEST_ITEM_SPAN} ${ITEM_SPAN})  # read by the controller only
  endif()
  if(NOT DEFINED WORKER_EXPECT)
    set(WORKER_EXPECT 0)
  endif()
  if(NOT DEFINED RUNS)
    set(RUNS 1)
  endif()
  file(GLOB old_caches "${WORKDIR}/${NAME}_cache*")
  if(old_caches)
    file(REMOVE_RECURSE ${old_caches})
  endif()
  file(REMOVE "${WORKDIR}/${NAME}.log")
  set(code K7QD-M2XR-9FHT-4WNB)
  # --no-upnp: tests never ask the router of the machine they run on to forward ports.
  string(REPLACE ";" "|" ctl "${PENUMBRA};${common};-o;${NAME}_net.exr;--host;--port;${PORT};--code;${code};--no-upnp")
  if(DEFINED CONTROLLER_KILL_MS)
    # Killed without warning (power loss), then resumed from its session file: same port and code.
    set(procs --proc "${NAME}_ctl" 0 killed ${CONTROLLER_KILL_MS} "${ctl}|${CONTROLLER_ARGS}")
    string(REPLACE ";" "|" resume "${PENUMBRA};--terminal;--resume;${WORKDIR}/${NAME}_net.session.json;--config;${cfg};--log-file;${WORKDIR}/${NAME}.log;--progress;plain")
    list(APPEND procs --proc "${NAME}_resumed" "after:${NAME}_ctl" 0 0 "${resume}")
    file(REMOVE "${WORKDIR}/${NAME}_net.session.json" "${WORKDIR}/${NAME}_net.penfilm")
  else()
    set(procs --proc "${NAME}_ctl" 0 0 0 "${ctl}|${CONTROLLER_ARGS}")
  endif()
  if(SECOND_RENDER)
    list(APPEND procs --proc "${NAME}_ctl2" "after:${NAME}_ctl" 0 0 "${ctl}|${CONTROLLER_ARGS}")
  endif()
  set(join_port ${PORT})
  if(DEFINED NETEM_ARGS)
    math(EXPR join_port "${PORT} + 100")
    list(APPEND procs --proc "${NAME}_proxy" 0 daemon 0
         "${NETEM}|--listen|${join_port}|--to|127.0.0.1:${PORT}|${NETEM_ARGS}")
  endif()
  set(join "--worker|--join|127.0.0.1:${join_port}|--config|${cfg}")
  file(REMOVE "${WORKDIR}/${NAME}_w1.log")
  foreach(i RANGE 1 ${WORKERS})
    if(SHARED_CACHE)
      set(cache "${WORKDIR}/${NAME}_cache")
    else()
      set(cache "${WORKDIR}/${NAME}_cache_w${i}")
    endif()
    set(w "${PENUMBRA}|${join}|--code|${code}|--cache-dir|${cache}|--log-file|${WORKDIR}/${NAME}_w${i}.log")
    if(DEFINED WORKER_ENV)
      set(w "${CMAKE_COMMAND}|-E|env|${WORKER_ENV}|${w}")
    endif()
    string(APPEND w "|--worker-name|w${i}|${WORKER_ARGS}")
    if(NOT WORKER_ARGS MATCHES "--backend")
      string(APPEND w "|--backend|cpu")
    endif()
    math(EXPR delay "${WORKER_DELAY_MS} * ${i}")
    if(i EQUAL 1 AND DEFINED FIRST_WORKER_ARGS)
      string(APPEND w "|${FIRST_WORKER_ARGS}")
    endif()
    if(i EQUAL 1 AND DEFINED FIRST_WORKER_ENV)
      if(NOT DEFINED FIRST_WORKER_EXPECT)
        set(FIRST_WORKER_EXPECT ${WORKER_EXPECT})
      endif()
      list(APPEND procs --proc "${NAME}_w${i}" ${delay} ${FIRST_WORKER_EXPECT} 0
           "${CMAKE_COMMAND}|-E|env|${FIRST_WORKER_ENV}|${w}")
    elseif(i EQUAL 1 AND DEFINED CRASH_FIRST_AFTER_CHUNKS)
      list(APPEND procs --proc "${NAME}_w${i}" ${delay} 137 0
           "${CMAKE_COMMAND}|-E|env|PENUMBRA_TEST_EXIT_AFTER_CHUNKS=${CRASH_FIRST_AFTER_CHUNKS}|${w}")
    elseif(i EQUAL 2 AND DEFINED CRASH_FIRST_AFTER_CHUNKS)
      list(APPEND procs --proc "${NAME}_w${i}" "after:${NAME}_w1" ${WORKER_EXPECT} 0 "${w}")
    else()
      list(APPEND procs --proc "${NAME}_w${i}" ${delay} ${WORKER_EXPECT} 0 "${w}")
    endif()
  endforeach()
  math(EXPR late "${WORKER_DELAY_MS} * (${WORKERS} + 1) + 1500")  # after the good workers have joined
  if(DEFINED WRONG_CODE_WORKERS AND WRONG_CODE_WORKERS GREATER 0)
    foreach(i RANGE 1 ${WRONG_CODE_WORKERS})
      set(w "${PENUMBRA}|${join}|--code|AAAA-AAAA-AAAA-AAAA|--log-file|${WORKDIR}/${NAME}_bad${i}.log|--worker-name|bad${i}")
      math(EXPR delay "${late} + 200 * ${i}")
      list(APPEND procs --proc "${NAME}_bad${i}" ${delay} 6 0 "${w}")
    endforeach()
  endif()
  if(BAD_VERSION_WORKER)
    set(w "${CMAKE_COMMAND}|-E|env|PENUMBRA_TEST_GIT_HASH=0000000badc0de|${PENUMBRA}|${join}|--code|${code}")
    string(APPEND w "|--log-file|${WORKDIR}/${NAME}_oldver.log|--worker-name|oldver")
    list(APPEND procs --proc "${NAME}_oldver" ${late} 6 0 "${w}")
  endif()
  if(FULL_DISK_WORKER)
    set(w "${CMAKE_COMMAND}|-E|env|PENUMBRA_TEST_FREE_DISK=1000|${PENUMBRA}|${join}|--code|${code}")
    string(APPEND w "|--cache-dir|${WORKDIR}/${NAME}_cache_full|--log-file|${WORKDIR}/${NAME}_full.log|--worker-name|full")
    list(APPEND procs --proc "${NAME}_full" 0 0 0 "${w}")
  endif()
  # The process list goes in a file: 64 workers would not fit on a Windows command line.
  set(spec "")
  list(LENGTH procs n)
  set(idx 0)
  while(idx LESS n)
    math(EXPR i1 "${idx} + 1")
    math(EXPR i2 "${idx} + 2")
    math(EXPR i3 "${idx} + 3")
    math(EXPR i4 "${idx} + 4")
    math(EXPR i5 "${idx} + 5")
    list(GET procs ${i1} f1)
    list(GET procs ${i2} f2)
    list(GET procs ${i3} f3)
    list(GET procs ${i4} f4)
    list(GET procs ${i5} f5)
    string(APPEND spec "${f1}\t${f2}\t${f3}\t${f4}\t${f5}\n")
    math(EXPR idx "${idx} + 6")
  endwhile()
  file(WRITE "${WORKDIR}/${NAME}_procs.txt" "${spec}")
  foreach(run RANGE 1 ${RUNS})
    file(REMOVE "${WORKDIR}/${NAME}_net.exr")
    execute_process(COMMAND "${NETTEST}" --workdir "${WORKDIR}" --timeout 900 --procs "${WORKDIR}/${NAME}_procs.txt"
                    WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
    message(STATUS "run ${run}:\n${o}${e}")
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "the network render failed (run ${run})")
    endif()
    if(DEFINED MAXRELMSE)
      diff("${NAME}_net.exr" "${NAME}_ref.exr" --max-relmse ${MAXRELMSE})
    else()
      diff("${NAME}_net.exr" "${NAME}_ref.exr" --exact)
    endif()
  endforeach()
  file(READ "${WORKDIR}/${NAME}.log" ctl_log)
  if(DEFINED EXPECT_LOG AND NOT ctl_log MATCHES "${EXPECT_LOG}")
    message(FATAL_ERROR "the controller log does not show '${EXPECT_LOG}'")
  endif()
  if(DEFINED EXPECT_WORKER_LOG)
    file(READ "${WORKDIR}/${NAME}_w1.log" w1_log)
    if(NOT w1_log MATCHES "${EXPECT_WORKER_LOG}")
      message(FATAL_ERROR "worker 1's log does not show '${EXPECT_WORKER_LOG}'")
    endif()
  endif()
  string(REGEX MATCHALL "\] [^\n]*: [0-9]+ items, [^\n]*" tallies "${ctl_log}")
  foreach(t IN LISTS tallies)
    message(STATUS "${t}")
  endforeach()
else()
  message(FATAL_ERROR "unknown MODE '${MODE}'")
endif()
