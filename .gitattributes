# Normalize line endings in the repo; shell scripts must stay LF so they run on Linux.
* text=auto
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary assets
*.glb binary
*.png binary
*.exr binary
*.jpg binary
*.hdr binary
*.penfilm binary
*.penpkg binary

# Sample scenes: byte-exact on every OS (they must equal penumbra-scenegen output; tests check it)
scenes/** -text
*.ttf binary
