{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "penumbra",
  "version": "0.1.0",
  "description": "Distributed multi-GPU path tracer",
  "license": "MIT",
  "builtin-baseline": "3cd21e48a75f67acfef289da52893ce79144aaa1",
  "dependencies": [
    "cgltf",
    "cli11",
    {
      "name": "embree",
      "default-features": false,
      "features": [ "filter-function", "geometry-instance", "geometry-triangle", "tasking-tbb" ]
    },
    "fmt",
    "libpng",
    "nlohmann-json",
    "openexr",
    "spdlog",
    "stb",
    {
      "name": "tbb",
      "default-features": false
    },
    "tinyobjloader"
  ],
  "features": {
    "tests": {
      "description": "Unit tests",
      "dependencies": [
        "catch2"
      ]
    }
  }
}
