{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "penumbra",
  "version": "0.1.0",
  "description": "Distributed multi-GPU path tracer",
  "license": "MIT",
  "builtin-baseline": "3cd21e48a75f67acfef289da52893ce79144aaa1",
  "dependencies": [
    "asio",
    "blake3",
    "cgltf",
    "cli11",
    {
      "name": "embree",
      "default-features": false,
      "features": [ "filter-function", "geometry-instance", "geometry-triangle", "tasking-tbb" ]
    },
    "fmt",
    "flatbuffers",
    "libjpeg-turbo",
    "libpng",
    "mbedtls",
    "miniupnpc",
    {
      "name": "libwebp",
      "default-features": false,
      "features": [ "simd" ]
    },
    "nlohmann-json",
    "openexr",
    {
      "name": "shader-slang",
      "host": true
    },
    "spdlog",
    "stb",
    {
      "name": "tbb",
      "default-features": false
    },
    {
      "name": "tiff",
      "default-features": false,
      "features": [ "zip" ]
    },
    "tinyobjloader",
    "volk",
    "vulkan-headers",
    "vulkan-memory-allocator",
    "zstd"
  ],
  "features": {
    "tests": {
      "description": "Unit tests",
      "dependencies": [
        "catch2"
      ]
    },
    "ui": {
      "description": "User interface window (Dear ImGui is vendored in third_party/imgui)",
      "dependencies": [
        "glfw3"
      ]
    }
  }
}
